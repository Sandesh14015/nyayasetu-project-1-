# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/nyayasetu

# Grok API (if you want to use Grok)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk-...
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (fallback or alternative provider)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_MODEL=gpt-4.1-mini

# Optional server settings
PORT=8080
NODE_ENV=development

# Provider order: grok first, then openai
AI_PROVIDER_ORDER=grok,openai
